{
  "info": {
    "name": "M03-00 Anatomía de una prueba de API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Leer el producto 1",
      "request": {
        "method": "GET",
        "url": "http://localhost:3300/api/productos/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('el estado es 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('responde JSON', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('el cuerpo es el producto 1', () => {",
              "  const producto = pm.response.json();",
              "  pm.expect(producto.id).to.eql(1);",
              "  pm.expect(producto.nombre).to.eql('Teclado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Leer un producto que no existe",
      "request": {
        "method": "GET",
        "url": "http://localhost:3300/api/productos/99"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('el estado es 404', () => {",
              "  pm.response.to.have.status(404);",
              "});",
              "pm.test('explica el error', () => {",
              "  pm.expect(pm.response.json().error).to.eql('Producto no encontrado');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}

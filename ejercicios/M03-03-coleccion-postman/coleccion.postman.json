{
  "info": {
    "name": "M03-03 API de libros",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar libros",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('el estado es 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('responde JSON', () => {",
              "  pm.response.to.be.json;",
              "});",
              "pm.test('devuelve una lista con libros', () => {",
              "  const libros = pm.response.json();",
              "  pm.expect(libros).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/libros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "libros"
          ]
        }
      }
    },
